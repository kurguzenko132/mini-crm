# Supabase
# Создай проект в Supabase, выполни SQL из supabase/schema.sql и вставь сюда значения из Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Необязательно. Для локального запуска можно оставить пустым.
NEXT_PUBLIC_APP_NAME=PilotBase

# Необязательно. Для отправки напоминаний в Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
